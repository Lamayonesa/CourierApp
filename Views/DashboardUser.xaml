<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiAppMaui.DashboardUser"
    Title="DashboardUser">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Label
            Text="Bienvenido a Courir App!"
            FontSize="30"
            HorizontalOptions="Center" />


        <Button Text="Paquetes"
        BackgroundColor="OrangeRed"
        TextColor="White"
        Clicked="OnPaquetesClicked" />

        <Button Text="Configuración"
        BackgroundColor="OrangeRed"
        TextColor="White"
        Clicked="OnConfigClicked" />




        <Button
                Text="Mi Cuenta"
                BackgroundColor="Orange"
                WidthRequest="250"
                HeightRequest="50" />

            <Button
                Text="Pedidos"
                BackgroundColor="Orange"
                WidthRequest="250"
                HeightRequest="50" />

        

    </VerticalStackLayout>

</ContentPage>