<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiAppMaui.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="10"
            Spacing="5"
            VerticalOptions="Center">

            <Label
                Text="Iniciar sesión"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="UsuarioEntry"
                Placeholder="Usuario" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Contraseña"
                IsPassword="True" />

            <Button
                Text="Iniciar sesión" BackgroundColor="OrangeRed" Clicked="Login"/>

            <Label
                x:Name="MensajeLabel"
                TextColor="Red"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
