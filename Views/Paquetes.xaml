<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiAppMaui.ViewModels"
             xmlns:models="clr-namespace:MiAppMaui.Models"
             x:DataType="vm:PaqueteViewModel"
             x:Class="MiAppMaui.Paquetes"
             Title="Paquetes">

    <Grid RowDefinitions="*,Auto,*" Padding="0,0,0,12">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registro de paquetes"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry Text="{Binding Descripcion}"
                   Placeholder="Descripción del paquete" />
            <Label Text="{Binding DescripcionError}" TextColor="Red" FontSize="12" />

            <Entry Text="{Binding Destinatario}"
                   Placeholder="Nombre del destinatario" />
            <Label Text="{Binding DestinatarioError}" TextColor="Red" FontSize="12" />

            <Entry Text="{Binding Destino}"
                   Placeholder="Dirección de destino" />
            <Label Text="{Binding DestinoError}" TextColor="Red" FontSize="12" />

            <Button Text="Registrar paquete"
                    BackgroundColor="OrangeRed"
                    TextColor="White"
                    Command="{Binding GuardarCommand}" />

        </VerticalStackLayout>
    </ScrollView>
        <Label Grid.Row="1" Text="Paquetes registrados" FontSize="20" FontAttributes="Bold" Margin="20,8" />
            <CollectionView Grid.Row="2" ItemsSource="{Binding Paquetes}">
                <CollectionView.EmptyView>
                    <Label Text="Todavía no hay registros." Margin="20,8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Paquetes">
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Descripcion}"
                                       FontAttributes="Bold"
                                       FontSize="17" />
                                <Label Text="{Binding Destinatario,
                                                      StringFormat='Destinatario: {0}'}" />
                                <Label Text="{Binding Destino,
                                                      StringFormat='Destino: {0}'}" />
                                <Label Text="{Binding Estado,
                                                      StringFormat='Estado: {0}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
    </Grid>
</ContentPage>
