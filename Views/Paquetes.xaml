<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppMaui.Paquetes"
             Title="Paquetes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registro de paquetes"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry x:Name="DescripcionEntry"
                   Placeholder="Descripción del paquete" />

            <Entry x:Name="DestinatarioEntry"
                   Placeholder="Nombre del destinatario" />

            <Entry x:Name="DestinoEntry"
                   Placeholder="Dirección de destino" />

            <Button Text="Registrar paquete"
                    BackgroundColor="OrangeRed"
                    TextColor="White"
                    Clicked="OnRegistrarClicked" />

            <Label Text="Paquetes registrados"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,15,0,0" />

            <CollectionView x:Name="PaquetesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Descripcion}"
                                       FontAttributes="Bold"
                                       FontSize="17" />
                                <Label Text="{Binding Destinatario,
                                                      StringFormat='Destinatario: {0}'}" />
                                <Label Text="{Binding Destino,
                                                      StringFormat='Destino: {0}'}" />
                                <Label Text="{Binding Estado,
                                                      StringFormat='Estado: {0}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
