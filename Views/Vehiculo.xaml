<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiAppMaui.ViewModels"
    xmlns:models="clr-namespace:MiAppMaui.Models"
             x:Class="MiAppMaui.Views.Vehiculo"
             x:DataType="vm:VehiculoFormViewModel"
             Title="Vehículos">
    <Grid RowDefinitions="*,Auto,Auto,*">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">
                <Label Text="Registro de vehículos" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
                <!-- Datos del vehículo -->
                <Label Text="Placa" />
                <Entry Text="{Binding Placa}" Placeholder="Placa del vehículo" />
                <Label Text="{Binding PlacaError}" TextColor="Red" FontSize="12" />
                <Label Text="Chasis" />
                <Entry Text="{Binding Chasis}" Placeholder="Número de chasis" />
                <Label Text="{Binding ChasisError}" TextColor="Red" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Text="Registrar vehículo" BackgroundColor="OrangeRed"
                TextColor="White" Command="{Binding GuardarCommand}" Margin="16" />

        <Label Grid.Row="2" Text="Vehículos registrados" FontSize="20" FontAttributes="Bold" Margin="16,4" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Vehiculos}" Margin="16,0,16,8">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay registros." Margin="0,8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Vehiculos">
                    <Border Stroke="LightGray" Padding="12" Margin="0,4" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontAttributes="Bold" />
                            <Label Text="{Binding Placa}" />
                            <Label Text="{Binding Chasis}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
