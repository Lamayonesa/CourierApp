<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppMaui.Views.cliente"
             Title="Clientes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registro de clientes"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry x:Name="NombreEntry"
                   Placeholder="Nombre completo" />

            <Entry x:Name="TelefonoEntry"
                   Placeholder="Número de teléfono"
                   Keyboard="Telephone" />

            <Entry x:Name="DireccionEntry"
                   Placeholder="Dirección" />

            <Button Text="Registrar cliente"
                    BackgroundColor="OrangeRed"
                    TextColor="White"
                    Clicked="OnRegistrarClicked" />

            <Label Text="Clientes registrados"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,15,0,0" />

            <CollectionView x:Name="ClientesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Nombre}"
                                       FontAttributes="Bold"
                                       FontSize="17" />
                                <Label Text="{Binding Telefono}" />
                                <Label Text="{Binding Direccion}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
